// 撞击工况：船舶撞击状态
//   撞击点在铰节点附近，防撞杆绕铰节点转动（杆顶偏向桥墩、杆底向外），
//   防撞杆径向内移 → 伸缩杆（液压阻尼杆）受压缩短；
//   撑杆推/拉套环沿防撞杆滑动 → 弹簧 1 受压、弹簧 2/3 受拉。
//   变形按环向 cos² 衰减分配，仅撞击侧三个模块参与变形。
//   转角与内移量取值使各杆件受力状态与 CAD 图"船舶撞击状态"标注一致
//   （弹簧1压力、弹簧2拉力、弹簧3拉力、液压杆压力），见 _tools/sweep_impact.py
$vpt = [0, 0, -2000];
$vpr = [60, 0, 40];
$vpd = 140000;  // 视口预设：打开后按 F5 即定位到模型


include <anticollision_lib.scad>

device(show_membrane = false, theta_deg = -12, pull = 900);
